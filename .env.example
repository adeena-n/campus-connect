# ==============================================================================
# CampusConnect — Unified Environment Configuration Example
# ==============================================================================

# --- AI Studio Platform Variables ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
PORT=3000

# --- Frontend Client Variables (VITE_ prefix is exposed to browser) ---
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# --- Backend Server Variables (Server-side ONLY, NEVER expose to browser) ---
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Optional: Password for the two evaluator accounts (evaluator.owner@campus.edu & evaluator.applicant@campus.edu)
EVALUATOR_PASSWORD="Evaluator2026!"
